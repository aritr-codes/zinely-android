<?xml version="1.0" encoding="utf-8"?>
<!-- Lossless, pixel-identical WebP projection of APP_LOGO.png; generated by tools/generate_launcher_assets.py. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Six dp on the 108dp adaptive canvas keeps the recognition-critical Z inside Android's
        mask-safe composition while still allowing the decorative scraps to reach the outer crop.
    -->
    <item
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/app_logo" />
    </item>
</layer-list>
